# AI providers — keep keys server-side; never put them in frontend code.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-large-latest
# Leave false/empty to prevent automatic use of metered providers.
ENABLE_METERED_PROVIDERS=false
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-5.6

# Optional generic ordinary telephone-number carrier bridge. Browser-to-browser
# calls do not need these values. The bridge receives outbound call requests and
# returns a provider_call_id plus status; send status events back to
# /api/phone/webhook with the x-iam-webhook-secret header.
VOIP_PROVIDER_NAME=
VOIP_PROVIDER_URL=
VOIP_PROVIDER_TOKEN=
VOIP_WEBHOOK_SECRET=
VOIP_CALLER_ID=

# Native service credentials can also be saved through the encrypted Owner
# Provider Setup screen instead of placing them in a local .env file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. If blank, Checkout creates the $49/month recurring price inline.
STRIPE_PRICE_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Authentication and credential encryption.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_NOW
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
INTEGRATION_CREDENTIALS_KEY=CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_SECRET
DATABASE_PATH=./iamagnanimous.db

# Connected-account OAuth application credentials.
# Store production values as Cloudflare secrets or in the encrypted Owner
# Provider Setup vault, not in GitHub or frontend code.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
WHATSAPP_CONFIG_ID=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

X_CLIENT_ID=
X_CLIENT_SECRET=

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
