{
  email {$MAGNANIMOUS_ACME_EMAIL}
}

{$MAGNANIMOUS_DOMAIN} {
  encode zstd gzip

  # Optional MediaMTX profile: secure HLS/WHIP HTTP paths are proxied here.
  handle_path /tv-media/hls/* {
    reverse_proxy live-media:8888
  }
  handle_path /tv-media/webrtc/* {
    reverse_proxy live-media:8889
  }

  reverse_proxy magnanimous:8788

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
    -Server
  }

  log {
    output stdout
    format json
  }
}
