# Magnanimous standalone runtime — no Cloudflare runtime dependency required.
PORT=8788
HOST=0.0.0.0
NODE_ENV=production

# First-party persistence.
MAGNANIMOUS_DB_PATH=/app/data/iam-magnanimous.sqlite
MAGNANIMOUS_OBJECTS_PATH=/app/data/object-store
MAGNANIMOUS_ASSETS_DIR=/app/frontend/out
MAGNANIMOUS_BACKUP_DIR=/app/backups

# Generate separate long random secrets. Do not reuse application/provider keys.
MAGNANIMOUS_INTERNAL_SERVICE_TOKEN=
MAGNANIMOUS_SECRETS_KEY=
SESSION_SECRET=
INTEGRATION_CREDENTIALS_KEY=

# Internal self-hosted services (Docker Compose defaults shown).
MAGNANIMOUS_SANDBOX_URL=http://sandbox:8791
MAGNANIMOUS_BROWSER_URL=http://browser:8792
MAGNANIMOUS_MEDIA_URL=http://media:8793

# Native scheduling / abuse limits.
MAGNANIMOUS_SCHEDULER_ENABLED=true
MAGNANIMOUS_SCHEDULE_INTERVAL_MS=900000
MAGNANIMOUS_API_RATE_LIMIT=1200
MAGNANIMOUS_AUTH_RATE_LIMIT=60

# Provider-neutral model execution. Prefer a Magnanimous/local compatible endpoint.
MAGNANIMOUS_AI_BASE_URL=
MAGNANIMOUS_AI_API_KEY=
MAGNANIMOUS_AI_MODEL=
MAGNANIMOUS_AI_MAX_TOKENS=2200
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Provider-neutral/local image generation. Prefer a local Automatic1111 endpoint.
AUTOMATIC1111_BASE_URL=
MAGNANIMOUS_IMAGE_BASE_URL=
MAGNANIMOUS_IMAGE_API_KEY=
MAGNANIMOUS_IMAGE_MODEL=

# Caddy / TLS.
MAGNANIMOUS_ACME_EMAIL=

# Self-hosted authoritative DNS cutover inputs.
# Use two independent real public DNS hosts and the real standalone origin address.
MAGNANIMOUS_DNS_NS1_IP=
MAGNANIMOUS_DNS_NS2_IP=
MAGNANIMOUS_DNS_ORIGIN_IP=
MAGNANIMOUS_DNS_TTL=300
MAGNANIMOUS_DNS_EXTRA_RECORDS_FILE=
