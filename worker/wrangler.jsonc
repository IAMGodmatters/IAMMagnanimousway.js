{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iam-magnanimous",
  "main": "src/white-label-brain-entrypoint.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "vars": {
    "STRIPE_PRICE_PLUS": "price_1UBWxgDuxV2kib03EAdmCMei",
    "STRIPE_PRICE_BUSINESS": "price_1UB9WfDuxV2kib03DFKqwM9C",
    "STRIPE_PRICE_PRO": "price_1UBWxlDuxV2kib03u7b61rOy",
    "STRIPE_PRICE_SCALE": "price_1UBWxqDuxV2kib0337oX8ARr",
    "STRIPE_PRICE_AGENCY": "price_1UEs75Bqx3ebIzujqlWosJKu",
    "STRIPE_PRICE_AGENCY_PRO": "price_1UEs7EBqx3ebIzujT5pbI3QH",
    "STRIPE_PAYMENT_LINK_PLUS": "https://buy.stripe.com/9B614n5oK7vE7LWbnT6kg02",
    "STRIPE_PAYMENT_LINK_BUSINESS": "https://buy.stripe.com/4gM9AT18u7vE9U463z6kg00",
    "STRIPE_PAYMENT_LINK_PRO": "https://buy.stripe.com/5kQcN5g3o4jsd6g2Rn6kg03",
    "STRIPE_PAYMENT_LINK_SCALE": "https://buy.stripe.com/5kQ28r04qbLU9U4ajP6kg04",
    "STRIPE_PAYMENT_LINK_USAGE_TOPUP": "https://buy.stripe.com/4gM00j2cyeY60jucrX6kg06",
    "ENABLE_METERED_PROVIDERS": "false",
    "CLOUDFLARE_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "OPENAI_MODEL": "gpt-5.6-sol",
    "BUSINESS_PLAN_MODEL": "gpt-5.6-sol",
    "BUSINESS_PLAN_FINAL_MODEL": "gpt-5.6-sol",
    "TARGET_GROSS_MARGIN_PERCENT": "20"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/health", "/persistent", "/restore", "/research", "/agency", "/funnels", "/email"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iam-magnanimous-db",
      "database_id": "7c9f798b-04d2-443c-a9e9-933c51899771",
      "migrations_dir": "migrations"
    }
  ]
}