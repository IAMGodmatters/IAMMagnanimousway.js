{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iam-magnanimous",
  "main": "src/consent-entrypoint.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "vars": {
    "STRIPE_PRICE_BUSINESS": "price_1UB9WfDuxV2kib03DFKqwM9C"
  },
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iam-magnanimous-db",
      "database_id": "7c9f798b-04d2-443c-a9e9-933c51899771",
      "migrations_dir": "migrations"
    }
  ]
}
