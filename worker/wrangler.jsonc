{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iam-magnanimous",
  "main": "src/multitenant-index.js",
  "compatibility_date": "2026-08-27",
  "assets": { "directory": "../frontend/out", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "iam-magnanimous-db", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ]
}
