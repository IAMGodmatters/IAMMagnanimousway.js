{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iam-magnanimous",
  // Security boundary delegates to src/operations-entrypoint.js, preserving the established non-destructive operations layer beneath it.
  "main": "src/security-entrypoint.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  // Production domain attachment is managed in Cloudflare outside this file.
  // The deploy token intentionally has Worker/D1 access but no zone-route mutation permission.
  "vars": {
    "STRIPE_PRICE_PLUS": "price_1UBWxgDuxV2kib03EAdmCMei",
    "STRIPE_PRICE_BUSINESS": "price_1UB9WfDuxV2kib03DFKqwM9C",
    "STRIPE_PRICE_PRO": "price_1UBWxlDuxV2kib03u7b61rOy",
    "STRIPE_PRICE_SCALE": "price_1UBWxqDuxV2kib0337oX8ARr",
    "STRIPE_PRICE_AGENCY": "price_1UEs75Bqx3ebIzujqlWosJKu",
    "STRIPE_PRICE_AGENCY_PRO": "price_1UEs7EBqx3ebIzujT5pbI3QH",
    "STRIPE_PAYMENT_LINK_PLUS": "https://buy.stripe.com/9B614n5oK7vE7LWbnT6kg02",
    "STRIPE_PAYMENT_LINK_BUSINESS": "https://buy.stripe.com/4gM9AT18u7vE9U463z6kg00",
    "STRIPE_PAYMENT_LINK_PRO": "https://buy.stripe.com/5kQcN5g3o4jsd6g2Rn6kg03",
    "STRIPE_PAYMENT_LINK_SCALE": "https://buy.stripe.com/5kQ28r04qbLU9U4ajP6kg04",
    "STRIPE_PAYMENT_LINK_USAGE_TOPUP": "https://buy.stripe.com/4gM00j2cyeY60jucrX6kg06",
    "ENABLE_METERED_PROVIDERS": "false",
    // Magnanimous AI remains the platform brain. These are internal execution helpers only.
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    // Agent Mesh starts with a fast reasoning worker; the runtime retains bounded GLM/Gemma/Nemotron fallbacks beneath Magnanimous.
    "AGENT_CLOUDFLARE_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "MAGNANIMOUS_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "MAGNANIMOUS_HEAVY_MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "BUSINESS_PLAN_FREE_MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "OPENAI_MODEL": "gpt-5.6-sol",
    "BUSINESS_PLAN_MODEL": "gpt-5.6-sol",
    "BUSINESS_PLAN_FINAL_MODEL": "gpt-5.6-sol",
    "TARGET_GROSS_MARGIN_PERCENT": "20"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/",
      "/api/*",
      "/mcp",
      "/.well-known/*",
      "/health",
      "/persistent",
      "/restore",
      "/research",
      "/agency",
      "/funnels",
      "/email",
      "/wp-admin*",
      "/wp-login.php",
      "/wp-json*",
      "/wp-content/*",
      "/wp-includes/*",
      "/xmlrpc.php",
      "/wp-cron.php",
      "/wp-signup.php",
      "/wp-activate.php",
      "/readme.html",
      "/license.txt"
    ]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iam-magnanimous-db",
      "database_id": "7c9f798b-04d2-443c-a9e9-933c51899771",
      "migrations_dir": "migrations"
    }
  ]
}