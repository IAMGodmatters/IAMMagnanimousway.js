# Magnanimous-owned SIP/PSTN core example. Copy to telecom-core/.env and replace every CHANGE_ME value.
MAGNANIMOUS_SIP_DOMAIN=sip.example.com
TELECOM_PUBLIC_IP=203.0.113.10
ASTERISK_SIP_PORT=5070

# Native browser-agent WebRTC. Keep disabled until a public TLS hostname/certificate is mounted and tested.
ASTERISK_WEBRTC_ENABLED=false
# Enable only after the public host passes the strict external browser/media proof.
ASTERISK_WEBRTC_DYNAMIC_SESSIONS_ENABLED=false
ASTERISK_WEBRTC_SESSION_TTL_SECONDS=3600
ASTERISK_HTTPS_PORT=8089
ASTERISK_WEBRTC_PUBLIC_URL=wss://sip.example.com:8089/ws
# Host-side directory mounted read-only at /certs. It may contain root-only key material.
ASTERISK_CERTS_DIR=./certs
ASTERISK_TLS_CERT_FILE=/certs/fullchain.pem
ASTERISK_TLS_KEY_FILE=/certs/privkey.pem
# Optional: set to a trusted STUN service you choose only if public/NAT media discovery requires it.
ASTERISK_STUN_SERVER=
# Optional owned TURN relay. The shared secret stays server-side; Telecom Core derives
# short-lived coturn REST credentials for each browser session. Prefer turns: over TCP
# when the public edge exposes TCP/TLS but not direct UDP to the browser.
MAGNANIMOUS_TURN_URLS=
MAGNANIMOUS_TURN_AUTH_SECRET=
MAGNANIMOUS_TURN_REALM=sip.example.com
MAGNANIMOUS_TURN_PORT=3478
MAGNANIMOUS_TURN_TLS_PORT=5349
MAGNANIMOUS_TURN_MIN_PORT=49160
MAGNANIMOUS_TURN_MAX_PORT=49260
MAGNANIMOUS_TURN_TLS_CERT_FILE=/certs/fullchain.pem
MAGNANIMOUS_TURN_TLS_KEY_FILE=/certs/privkey.pem
# Keep false unless an externally tested relay path is required. When true, browser
# sessions fail closed unless TURN is fully configured and use relay-only ICE.
MAGNANIMOUS_TURN_FORCE_RELAY=false
MAGNANIMOUS_WEBRTC_EXTENSION=1100
MAGNANIMOUS_WEBRTC_ECHO_EXTENSION=6000
MAGNANIMOUS_WEBRTC_PASSWORD=CHANGE_ME_LONG_RANDOM_WEBRTC_PASSWORD

# Owned SIP subscriber database (keep password URL-safe and private).
SIP_DB_HOST_PORT=5433
SIP_DB_NAME=magnanimous_sip
SIP_DB_USER=magnanimous_sip
SIP_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
SIP_MAX_CONTACTS=5

# Private Telecom control API / Asterisk control plane.
TELECOM_API_TOKEN=CHANGE_ME_LONG_RANDOM_API_TOKEN
TELECOM_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WEBHOOK_SECRET
ASTERISK_ARI_USER=magnanimous-ari
ASTERISK_ARI_PASSWORD=CHANGE_ME_LONG_RANDOM_ARI_PASSWORD
MAGNANIMOUS_ADMIN_EXTENSION=1000
MAGNANIMOUS_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
MAGNANIMOUS_AI_EXTENSION=9000
MAGNANIMOUS_AI_PASSWORD=CHANGE_ME_LONG_RANDOM_AI_PASSWORD
MAGNANIMOUS_CALLER_ID=

# Replaceable PSTN interconnect. Leave blank until an authorized carrier/direct interconnect exists.
CARRIER_SIP_ENDPOINT=pstn-trunk
CARRIER_SIP_HOST=
CARRIER_SIP_PORT=5060
CARRIER_SIP_USERNAME=
CARRIER_SIP_PASSWORD=
CARRIER_SIP_FROM_DOMAIN=

# Optional secondary interconnect for network-failure failover. Keep blank until
# a second authorized SIP carrier is configured and tested.
CARRIER_SIP_SECONDARY_ENDPOINT=
CARRIER_SIP_SECONDARY_HOST=
CARRIER_SIP_SECONDARY_PORT=5060
CARRIER_SIP_SECONDARY_USERNAME=
CARRIER_SIP_SECONDARY_PASSWORD=
CARRIER_SIP_SECONDARY_FROM_DOMAIN=
