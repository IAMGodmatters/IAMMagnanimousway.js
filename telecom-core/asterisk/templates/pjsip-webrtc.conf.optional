; Rendered only when ASTERISK_WEBRTC_ENABLED=true.
[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0

[${MAGNANIMOUS_WEBRTC_EXTENSION}]
type=aor
max_contacts=5
remove_existing=yes
qualify_frequency=30

[${MAGNANIMOUS_WEBRTC_EXTENSION}]
type=auth
auth_type=userpass
username=${MAGNANIMOUS_WEBRTC_EXTENSION}
password=${MAGNANIMOUS_WEBRTC_PASSWORD}

[${MAGNANIMOUS_WEBRTC_EXTENSION}]
type=endpoint
aors=${MAGNANIMOUS_WEBRTC_EXTENSION}
auth=${MAGNANIMOUS_WEBRTC_EXTENSION}
transport=transport-wss
context=magnanimous-internal
disallow=all
allow=opus,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
webrtc=yes
use_avpf=yes
media_encryption=dtls
dtls_verify=fingerprint
dtls_setup=actpass
dtls_cert_file=${ASTERISK_TLS_CERT_FILE}
dtls_private_key=${ASTERISK_TLS_KEY_FILE}
ice_support=yes
media_use_received_transport=yes
rtcp_mux=yes
