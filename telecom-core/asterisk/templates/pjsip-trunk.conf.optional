[pstn-auth]
type=auth
auth_type=userpass
username=${PSTN_TRUNK_USERNAME}
password=${PSTN_TRUNK_PASSWORD}

[pstn-aor]
type=aor
contact=sip:${PSTN_TRUNK_HOST}:${PSTN_TRUNK_PORT}
qualify_frequency=30

[pstn-trunk]
type=endpoint
transport=transport-udp
context=from-pstn
disallow=all
allow=ulaw,alaw
aors=pstn-aor
outbound_auth=pstn-auth
from_user=${PSTN_TRUNK_USERNAME}
from_domain=${PSTN_TRUNK_FROM_DOMAIN}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[pstn-identify]
type=identify
endpoint=pstn-trunk
match=${PSTN_TRUNK_HOST}

[pstn-registration]
type=registration
transport=transport-udp
outbound_auth=pstn-auth
server_uri=sip:${PSTN_TRUNK_HOST}:${PSTN_TRUNK_PORT}
client_uri=sip:${PSTN_TRUNK_USERNAME}@${PSTN_TRUNK_HOST}
retry_interval=60
forbidden_retry_interval=300
expiration=300
