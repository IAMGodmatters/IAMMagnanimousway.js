[${CARRIER_SIP_ENDPOINT}-auth]
type=auth
auth_type=userpass
username=${CARRIER_SIP_USERNAME}
password=${CARRIER_SIP_PASSWORD}

[${CARRIER_SIP_ENDPOINT}-aor]
type=aor
contact=sip:${CARRIER_SIP_HOST}:${CARRIER_SIP_PORT}
qualify_frequency=30

[${CARRIER_SIP_ENDPOINT}]
type=endpoint
transport=transport-udp
context=from-pstn
disallow=all
allow=ulaw,alaw
aors=${CARRIER_SIP_ENDPOINT}-aor
outbound_auth=${CARRIER_SIP_ENDPOINT}-auth
from_user=${CARRIER_SIP_USERNAME}
from_domain=${CARRIER_SIP_FROM_DOMAIN}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[${CARRIER_SIP_ENDPOINT}-identify]
type=identify
endpoint=${CARRIER_SIP_ENDPOINT}
match=${CARRIER_SIP_HOST}

[${CARRIER_SIP_ENDPOINT}-registration]
type=registration
transport=transport-udp
outbound_auth=${CARRIER_SIP_ENDPOINT}-auth
server_uri=sip:${CARRIER_SIP_HOST}:${CARRIER_SIP_PORT}
client_uri=sip:${CARRIER_SIP_USERNAME}@${CARRIER_SIP_HOST}
retry_interval=60
forbidden_retry_interval=300
expiration=300
