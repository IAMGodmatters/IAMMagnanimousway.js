[general]
static=yes
writeprotect=yes
clearglobalvars=no

[globals]
MAGNANIMOUS_AI_EXTENSION=${MAGNANIMOUS_AI_EXTENSION}
MAGNANIMOUS_ADMIN_EXTENSION=${MAGNANIMOUS_ADMIN_EXTENSION}
MAGNANIMOUS_WEBRTC_EXTENSION=${MAGNANIMOUS_WEBRTC_EXTENSION}
MAGNANIMOUS_WEBRTC_ECHO_EXTENSION=${MAGNANIMOUS_WEBRTC_ECHO_EXTENSION}
CARRIER_SIP_ENDPOINT=${CARRIER_SIP_ENDPOINT}
CARRIER_SIP_SECONDARY_ENDPOINT=${CARRIER_SIP_SECONDARY_ENDPOINT}

[magnanimous-webrtc]
; Legacy/static native browser endpoint. Preserved for diagnostics and fallback.
include => magnanimous-internal
exten => ${MAGNANIMOUS_WEBRTC_ECHO_EXTENSION},1,Answer()
 same => n,Echo()
 same => n,Hangup()

[magnanimous-webrtc-session]
; Ephemeral browser identities are intentionally restricted. They may reach
; Magnanimous internal SIP endpoints and the carrier-free echo diagnostic, but
; they cannot dial public E.164 destinations directly and therefore cannot
; bypass platform billing, consent, DNC, or regulated-network controls.
exten => ${MAGNANIMOUS_WEBRTC_ECHO_EXTENSION},1,Answer()
 same => n,Echo()
 same => n,Hangup()
exten => 911,1,Playback(ss-noservice)
 same => n,Hangup()
exten => 112,1,Playback(ss-noservice)
 same => n,Hangup()
exten => _+X.,1,Playback(ss-noservice)
 same => n,Hangup()
exten => ${MAGNANIMOUS_ADMIN_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_ADMIN_EXTENSION},45)
 same => n,Hangup()
exten => ${MAGNANIMOUS_AI_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_AI_EXTENSION},45)
 same => n,Hangup()
exten => _X.,1,Dial(PJSIP/${EXTEN}@magnanimous-sip-core,45)
 same => n,Hangup()

[magnanimous-internal]
; Existing direct Asterisk extensions remain available for backward compatibility.
exten => ${MAGNANIMOUS_ADMIN_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_ADMIN_EXTENSION},45)
 same => n,Hangup()
exten => ${MAGNANIMOUS_AI_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_AI_EXTENSION},45)
 same => n,Hangup()
exten => ${MAGNANIMOUS_WEBRTC_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_WEBRTC_EXTENSION},45)
 same => n,Hangup()

; Other numeric extensions are delivered through the owned SIP registrar.
exten => _X.,1,Dial(PJSIP/${EXTEN}@magnanimous-sip-core,45)
 same => n,Hangup()

; Public-network calls use E.164 format. Emergency calling stays deliberately
; unavailable until a compliant emergency-services route is contracted/tested.
exten => 911,1,Playback(ss-noservice)
 same => n,Hangup()
exten => 112,1,Playback(ss-noservice)
 same => n,Hangup()
exten => _+X.,1,Goto(magnanimous-outbound,${EXTEN},1)

[from-sip-core]
; Every authenticated Magnanimous SIP subscriber reaches the PBX through here.
; Asterisk anchors media and owns dial policy before any PSTN interconnect is used.
exten => 911,1,Playback(ss-noservice)
 same => n,Hangup()
exten => 112,1,Playback(ss-noservice)
 same => n,Hangup()
exten => ${MAGNANIMOUS_ADMIN_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_ADMIN_EXTENSION},45)
 same => n,Hangup()
exten => ${MAGNANIMOUS_AI_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_AI_EXTENSION},45)
 same => n,Hangup()
exten => ${MAGNANIMOUS_WEBRTC_EXTENSION},1,Dial(PJSIP/${MAGNANIMOUS_WEBRTC_EXTENSION},45)
 same => n,Hangup()
exten => _+X.,1,Goto(magnanimous-outbound,${EXTEN},1)
exten => _X.,1,Dial(PJSIP/${EXTEN}@magnanimous-sip-core,45)
 same => n,Hangup()

[magnanimous-outbound]
exten => _+X.,1,NoOp(Magnanimous outbound PSTN bridge call to ${EXTEN})
 same => n,Set(CALLERID(num)=${MAG_FROM})
 same => n,Dial(PJSIP/${EXTEN}@${CARRIER_SIP_ENDPOINT},60)
 same => n,GotoIf($["${CARRIER_SIP_SECONDARY_ENDPOINT}"=""]?done)
 same => n,GotoIf($["${DIALSTATUS}"="CHANUNAVAIL"]?secondary)
 same => n,GotoIf($["${DIALSTATUS}"="CONGESTION"]?secondary:done)
 same => n(secondary),NoOp(Primary carrier unavailable - trying Magnanimous secondary SIP interconnect)
 same => n,Dial(PJSIP/${EXTEN}@${CARRIER_SIP_SECONDARY_ENDPOINT},60)
 same => n(done),Hangup()

[magnanimous-outbound-primary]
; Explicit planner-selected primary route. No automatic cross-carrier retry occurs here.
exten => _+X.,1,NoOp(Magnanimous selected primary PSTN route call to ${EXTEN})
 same => n,Set(CALLERID(num)=${MAG_FROM})
 same => n,Dial(PJSIP/${EXTEN}@${CARRIER_SIP_ENDPOINT},60)
 same => n,Hangup()

[magnanimous-outbound-secondary]
; Explicit planner-selected secondary route. The control API refuses this route unless configured.
exten => _+X.,1,NoOp(Magnanimous selected secondary PSTN route call to ${EXTEN})
 same => n,Set(CALLERID(num)=${MAG_FROM})
 same => n,Dial(PJSIP/${EXTEN}@${CARRIER_SIP_SECONDARY_ENDPOINT},60)
 same => n,Hangup()

[magnanimous-ai]
; The public party is bridged to the Magnanimous AI SIP endpoint after answer.
exten => s,1,NoOp(Connecting call ${MAG_CALL_ID} to Magnanimous AI)
 same => n,Dial(PJSIP/${MAGNANIMOUS_AI_EXTENSION},60)
 same => n,Hangup()

[from-pstn]
; Inbound PSTN/DID calls remain branded and controlled by Magnanimous.
exten => _X.,1,NoOp(Magnanimous inbound PSTN call ${CALLERID(num)} -> ${EXTEN})
 same => n,Dial(PJSIP/${MAGNANIMOUS_AI_EXTENSION},60)
 same => n,Hangup()
exten => _+X.,1,NoOp(Magnanimous inbound PSTN call ${CALLERID(num)} -> ${EXTEN})
 same => n,Dial(PJSIP/${MAGNANIMOUS_AI_EXTENSION},60)
 same => n,Hangup()
