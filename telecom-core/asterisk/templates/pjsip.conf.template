[global]
type=global
user_agent=Magnanimous-Telecom
endpoint_identifier_order=auth_username,username,ip,anonymous

; Public subscriber SIP lives on Kamailio port 5060. Asterisk uses 5070 as the
; owned PBX/media and carrier edge so the two services never fight for a socket.
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:${ASTERISK_SIP_PORT}

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:${ASTERISK_SIP_PORT}

; Trusted loopback route to the Magnanimous SIP registrar/proxy.
[magnanimous-sip-core]
type=aor
contact=sip:127.0.0.1:5060
qualify_frequency=30

[magnanimous-sip-core]
type=endpoint
aors=magnanimous-sip-core
transport=transport-udp
context=from-sip-core
disallow=all
allow=opus,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
trust_id_inbound=no
trust_id_outbound=no

[magnanimous-sip-core-identify]
type=identify
endpoint=magnanimous-sip-core
match=127.0.0.1

[${MAGNANIMOUS_ADMIN_EXTENSION}]
type=aor
max_contacts=5
remove_existing=yes

[${MAGNANIMOUS_ADMIN_EXTENSION}]
type=auth
auth_type=userpass
username=${MAGNANIMOUS_ADMIN_EXTENSION}
password=${MAGNANIMOUS_ADMIN_PASSWORD}

[${MAGNANIMOUS_ADMIN_EXTENSION}]
type=endpoint
aors=${MAGNANIMOUS_ADMIN_EXTENSION}
auth=${MAGNANIMOUS_ADMIN_EXTENSION}
context=magnanimous-internal
disallow=all
allow=opus,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[${MAGNANIMOUS_AI_EXTENSION}]
type=aor
max_contacts=5
remove_existing=yes

[${MAGNANIMOUS_AI_EXTENSION}]
type=auth
auth_type=userpass
username=${MAGNANIMOUS_AI_EXTENSION}
password=${MAGNANIMOUS_AI_PASSWORD}

[${MAGNANIMOUS_AI_EXTENSION}]
type=endpoint
aors=${MAGNANIMOUS_AI_EXTENSION}
auth=${MAGNANIMOUS_AI_EXTENSION}
context=magnanimous-internal
disallow=all
allow=opus,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

; Browser/WebRTC clients can keep using the Asterisk WSS endpoint where needed.
; General SIP subscribers register against the Magnanimous SIP Core on port 5060.

#include pjsip-webrtc.conf
#include pjsip-trunk.conf
#include pjsip-trunk-secondary.conf
