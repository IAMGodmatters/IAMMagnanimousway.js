#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - jq

write_files:
  - path: /etc/motd.d/99-magnanimous-telecom
    permissions: "0644"
    content: |
      I AM MAGNANIMOUS WAY - Magnanimous Telecom Core host

      Source is installed from the owner's authenticated Cloud Shell checkout.
      No repository token, deploy key, or private GitHub URL is stored in
      instance metadata or cloud-init.

      After provisioning, run telecom-core/oci/publish-source.sh from
      the authenticated Cloud Shell checkout. Then run the preflight:

        cd /opt/IAMMagnanimousway.js
        bash telecom-core/deploy/oci-always-free-preflight.sh

      Do not set TELECOM_NATIVE_WEBRTC_LIVE=true until the external
      Public Telecom WebRTC Verification workflow passes.

runcmd:
  - [ mkdir, -p, /opt ]
